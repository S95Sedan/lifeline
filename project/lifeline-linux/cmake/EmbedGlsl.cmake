file(READ "${INPUT}" _source)
string(LENGTH "${_source}" _length)
set(_offset 0)
set(_literals "")
while(_offset LESS _length)
    string(SUBSTRING "${_source}" ${_offset} 8192 _chunk)
    string(APPEND _literals "R\"LIFELINE_GLSL(${_chunk})LIFELINE_GLSL\"\n")
    math(EXPR _offset "${_offset}+8192")
endwhile()
if(NOT DEFINED SYMBOL)
    set(SYMBOL opengl_scene_shader)
endif()
file(WRITE "${OUTPUT}" "#pragma once\nnamespace lifeline { inline constexpr char ${SYMBOL}[]=\n${_literals}; }\n")
